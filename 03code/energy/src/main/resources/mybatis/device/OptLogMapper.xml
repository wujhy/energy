<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shanhe.project.manage.opt.mapper.OptLogMapper">

    <resultMap id="BaseResultMap" type="com.shanhe.project.manage.opt.domain.OptLog">
            <id property="id" column="id" />
            <result property="configId" column="config_id" />
            <result property="packNum" column="pack_num" />
            <result property="type" column="type" />
            <result property="content" column="content" />
            <result property="result" column="result" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
        <result property="bcapacity" column="bcapacity" />
        <result property="current" column="current" />
        <result property="dischargeCapacity" column="discharge_capacity" />
        <result property="source" column="source" />
        <result property="channelName" column="channel_name" />
        <result property="targetType" column="target_type" />
        <result property="targetAddress" column="target_address" />
        <result property="mode" column="mode" />
        <result property="status" column="status" />
        <result property="requestCode" column="request_code" />
        <result property="responseCode" column="response_code" />
        <result property="protocolCode" column="protocol_code" />
        <result property="commandName" column="command_name" />
        <result property="requestPayload" column="request_payload" />
        <result property="responsePayload" column="response_payload" />
        <result property="errorMessage" column="error_message" />
        <result property="pollBatchNo" column="poll_batch_no" />
        <result property="startedAt" column="started_at" />
        <result property="endedAt" column="ended_at" />
    </resultMap>

    <sql id="Base_Column_List">
        id,config_id,pack_num,type,content,result,create_time,update_time,bcapacity,current,discharge_capacity,
        source,channel_name,target_type,target_address,mode,status,request_code,response_code,
        protocol_code,command_name,request_payload,response_payload,error_message,
        poll_batch_no,started_at,ended_at
    </sql>

    <!-- 插入操作日志 -->
    <insert id="insert">
        insert into dev_opt_log (id,config_id,pack_num,type,content,result,create_time,
            source,channel_name,target_type,target_address,mode,status,
            request_code,response_code,protocol_code,command_name,
            request_payload,response_payload,error_message,poll_batch_no,started_at,ended_at)
        values (#{id},#{configId},#{packNum},#{type},#{content},#{result},#{createTimeStr},
            #{source},#{channelName},#{targetType},#{targetAddress},#{mode},#{status},
            #{requestCode},#{responseCode},#{protocolCode},#{commandName},
            #{requestPayload},#{responsePayload},#{errorMessage},#{pollBatchNo},#{startedAt},#{endedAt})
    </insert>

    <!-- 更新操作结果 -->
    <update id="update">
        update dev_opt_log
        set result      = #{result},
            update_time = #{updateTimeStr}
        where id = #{id}
    </update>

    <update id="updateRuntime">
        update dev_opt_log
        set status = #{status},
            result = #{result},
            <if test="endedAt != null">ended_at = #{endedAt},</if>
            update_time = strftime('%Y-%m-%d %H:%M:%S', 'now', 'localtime')
        where id = #{id} and result is null
    </update>
    <!-- 查询操作日志列表 -->
    <select id="select" parameterType="com.shanhe.project.manage.opt.domain.OptLog" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from dev_opt_log
        <where>
            <if test="result != null "> and result = #{result}</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="configId != null "> and config_id = #{configId}</if>
            <if test="packNum != null "> and pack_num = #{packNum}</if>
            <if test="source != null and source != ''"> and source = #{source}</if>
            <if test="channelName != null and channelName != ''"> and channel_name = #{channelName}</if>
            <if test="targetType != null and targetType != ''"> and target_type = #{targetType}</if>
            <if test="targetAddress != null"> and target_address = #{targetAddress}</if>
            <if test="mode != null"> and mode = #{mode}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="protocolCode != null and protocolCode != ''"> and protocol_code = #{protocolCode}</if>
            <if test="commandName != null and commandName != ''"> and command_name = #{commandName}</if>
            <if test="params != null and params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
                and strftime('%Y-%m-%d %H:%M:%S', create_time) &gt;= strftime('%Y-%m-%d %H:%M:%S', #{params.beginTime})
            </if>
            <if test="params != null and params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
                and strftime('%Y-%m-%d %H:%M:%S', create_time) &lt;= strftime('%Y-%m-%d %H:%M:%S', #{params.endTime})
            </if>
            <if test="params != null and params.startedAtBegin != null and params.startedAtBegin != ''"><!-- 命令开始时间检索 -->
                and started_at &gt;= #{params.startedAtBegin}
            </if>
            <if test="params != null and params.startedAtEnd != null and params.startedAtEnd != ''">
                and started_at &lt;= #{params.startedAtEnd}
            </if>
            <if test="params != null and params.endedAtBegin != null and params.endedAtBegin != ''"><!-- 命令结束时间检索 -->
                and ended_at &gt;= #{params.endedAtBegin}
            </if>
            <if test="params != null and params.endedAtEnd != null and params.endedAtEnd != ''">
                and ended_at &lt;= #{params.endedAtEnd}
            </if>
            <if test="params != null and params.errorMessage != null and params.errorMessage != ''">
                and error_message like '%' || #{params.errorMessage} || '%'
            </if>
        </where>
        <choose>
            <when test="params != null and params.orderByColumn == 'create_time'">order by create_time</when>
            <when test="params != null and params.orderByColumn == 'started_at'">order by started_at</when>
            <when test="params != null and params.orderByColumn == 'ended_at'">order by ended_at</when>
            <when test="params != null and params.orderByColumn == 'pack_num'">order by pack_num</when>
            <otherwise>order by id</otherwise>
        </choose>
        <choose>
            <when test="params != null and params.isAsc == 'asc'">asc</when>
            <otherwise>desc</otherwise>
        </choose>
    </select>

    <!-- 批量删除操作日志 -->
    <delete id="deleteByIds">
        delete from dev_opt_log where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 删除默认设备操作日志 -->
    <delete id="deleteDefaultDeviceLogs">
        delete from dev_opt_log where config_id = 1
    </delete>

    <!-- 查询运行中日志 -->
    <select id="findRunningList" parameterType="com.shanhe.project.manage.opt.domain.OptLog" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from dev_opt_log where result is null and type != 99 order by create_time desc
    </select>


    <!-- 查询指定电池组运行中日志 -->
    <select id="selectRunningList" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from dev_opt_log
        where config_id = 1 and result is null and type != 99
        <if test="packNum != null">
            and pack_num = #{packNum}
        </if>
        order by create_time desc
    </select>
    <!-- 更新电池参数 -->
    <update id="updateBattery">
        update dev_opt_log
        set
        <if test=" bcapacity != null and bcapacity != '' ">
            bcapacity = #{bcapacity},
        </if>
        <if test=" dischargeCapacity != null ">
            discharge_capacity = #{dischargeCapacity},
        </if>
        <if test=" current != null ">
            current = #{current},
        </if>
        update_time = #{endTimeStr}
        where id = #{id}
    </update>


    <!-- 获取运行中日志 -->
    <select id="getRunningOptLog" parameterType="com.shanhe.project.manage.opt.domain.OptLog" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from dev_opt_log
        where type = #{type} and config_id = 1 and result is null
        <if test="packNum != null">
            and pack_num = #{packNum}
        </if>
        limit 1
    </select>

    <!-- 统计操作日志数量 -->
    <select id="count" resultType="java.lang.Integer">
        select count(1) from dev_opt_log
        <where>
            and config_id = 1
            <if test="packNum != null ">
                and pack_num = #{packNum}
            </if>
            <if test="types != null and types.size() > 0 ">
                and type in
                <foreach item="item" collection="types" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>

    <!-- 查询最近操作日志 -->
    <select id="lastByType" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from dev_opt_log
        where type = #{type}
        and config_id = 1
        and pack_num = #{packNum}
        order by id desc
        limit 1
    </select>

    <!-- 按默认设备和组号删除 -->
    <delete id="deleteByPackNum">
        delete from dev_opt_log where config_id = 1 and pack_num = #{packNum}
    </delete>


    <!-- 更新600模块命令执行状态 -->
    <update id="updateCommandStatus">
        update dev_opt_log
        set status = #{status},
            result = #{result},
            <if test="responseCode != null">response_code = #{responseCode},</if>
            ended_at = #{endedAt},
            error_message = #{errorMessage},
            <if test="responsePayload != null">response_payload = #{responsePayload},</if>
            update_time = strftime('%Y-%m-%d %H:%M:%S', 'now', 'localtime')
        where id = #{id}
    </update>
</mapper>
